FoundPetDetails'\nimport { BrowserRouter, Routes, Route } from 'react-router-dom';\nimport { useAuthState } from 'react-firebase-hooks/auth';\nimport { auth } from \"./firebaseconfig\";\n\nfunction App() {\n\n  const [user] = useAuthState(auth);\n\n  console.log(user);\n\n\n  return (\n    <div className ='app'>\n      <BrowserRouter>\n      {user == null? \n      <Routes>\n        <Route path = \"/\" element = {<Login />} />\n        <Route path = \"/register\" element = {<Register />} />\n      </Routes>\n      :\n      <Routes>\n        <Route path = \"/home\" element = {<Homepage />} />\n        <Route path = \"/found\" element = {<Found />} />\n        <Route path = \"/found-pet-details\" element = {<FoundPetDetails />} />\n      </Routes>\n    }\n      </BrowserRouter>\n    </div>\n  );\n}\n\nexport default App;\n","/Users/niallmcnamara/Desktop/fyprep/FinalYearProject/src/reportWebVitals.js",[],"/Users/niallmcnamara/Desktop/fyprep/FinalYearProject/src/Components/Homepage/Homepage.js",["54","55","56"],"//import react from \"react\";\nimport './Homepage.css'\nimport { logout } from \"../../firebaseconfig\";\n\nexport default function Homepage(){\n\n    function found(){\n        window.location = \"/found\";\n    }\n\n    return(\n        <div>\n            <title>FindMyOwner</title>\n            <div id = \"Title\">\n                <h1>FindMyOwner</h1>\n                <button id = \"logout\" onClick = {logout} >Log out</button>\n            </div>\n            <div id = \"sidebar\">\n                <button id = \"found\" onClick={found}>\n                    <h2>Found Pets</h2>\n                </button>\n                <a href = \"#\">\n                    <h2>Lost Pets</h2>\n                </a>\n                <a href = \"#\">\n                    <h2>Pet Clinics</h2>\n                </a>\n                <a href = \"#\">\n                    <h2 id = \"DWS\">Dog Warden Service</h2>\n                </a>\n            </div>\n            <div id = \"topbar\">\n                <h3 id = \"RP\">Recent Posts</h3>\n                <h3 id = \"PNM\">Posts near me</h3>\n            </div>\n            <div id = \"RecentPosts\">\n                \n            </div>\n            <div id = \"PostsNearMe\">\n\n            </div>\n        </div>\n    )\n}","/Users/niallmcnamara/Desktop/fyprep/FinalYearProject/src/Components/Found/Found.js",[],"/Users/niallmcnamara/Desktop/fyprep/FinalYearProject/src/Components/Login/Login.js",["57","58"],"import React, { useEffect, useState } from \"react\";\nimport { Link, useNavigate } from \"react-router-dom\";\nimport { auth, signInWithEmailAndPassword, signInWithFacebook } from \"../../firebaseconfig\";\nimport { useAuthState } from \"react-firebase-hooks/auth\";\nimport \"./Login.css\";\nfunction Login() {\n  const [email, setEmail] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [user, loading, error] = useAuthState(auth);\n  const history = useNavigate();\n  useEffect(() => {\n    if (loading) {\n      // maybe trigger a loading screen\n      return;\n    }\n    if (user) history(\"/home\");\n  }, [user, loading]);\n  return (\n    <div className=\"login\">\n      <div className=\"login__container\">\n        <input\n          type=\"text\"\n          className=\"login__textBox\"\n          value={email}\n          onChange={(e) => setEmail(e.target.value)}\n          placeholder=\"E-mail Address\"\n        />\n        <input\n          type=\"password\"\n          className=\"login__textBox\"\n          value={password}\n          onChange={(e) => setPassword(e.target.value)}\n          placeholder=\"Password\"\n        />\n        <button\n          className=\"login__btn\"\n          onClick={() => signInWithEmailAndPassword(email, password)}\n        >\n          Login\n        </button>\n        <button className=\"login__btn login__google\" onClick={signInWithFacebook}>\n          Login with Facebook\n        </button>\n        {/*<div>\n          <Link to=\"/reset\">Forgot Password</Link>\n        </div>*/}\n        <div>\n          Don't have an account? <Link to=\"/register\">Register</Link> now.\n        </div>\n      </div>\n    </div>\n  );\n}\nexport default Login;","/Users/niallmcnamara/Desktop/fyprep/FinalYearProject/src/firebaseconfig.js",["59","60","61","62","63","64"],"/Users/niallmcnamara/Desktop/fyprep/FinalYearProject/src/Components/Register/Register.js",[],"/Users/niallmcnamara/Desktop/fyprep/FinalYearProject/src/Components/FoundPetDetails/FoundPetDetails.js",["65","66","67","68","69","70","71"],"/Users/niallmcnamara/Desktop/fyprep/FinalYearProject/src/Components/FoundPetDetails/GoogleMaps.js",[],"/Users/niallmcnamara/Desktop/fyprep/FinalYearProject/src/keys.js",["72"],"const googleAPIkey = 'AIzaSyCwGo-9ejeEDZdnqjukoIYbBkknoPq-QFQ';\nconst dogBreedAPI = 'b8fef6dd-50c8-413d-9dd1-3049eb6d8fc1';\n\nexport {googleAPIkey};",{"ruleId":"73","replacedBy":"74"},{"ruleId":"75","replacedBy":"76"},{"ruleId":"77","severity":1,"message":"78","line":1,"column":8,"nodeType":"79","messageId":"80","endLine":1,"endColumn":12},{"ruleId":"81","severity":1,"message":"82","line":22,"column":17,"nodeType":"83","endLine":22,"endColumn":31},{"ruleId":"81","severity":1,"message":"82","line":25,"column":17,"nodeType":"83","endLine":25,"endColumn":31},{"ruleId":"81","severity":1,"message":"82","line":28,"column":17,"nodeType":"83","endLine":28,"endColumn":31},{"ruleId":"77","severity":1,"message":"84","line":9,"column":25,"nodeType":"79","messageId":"80","endLine":9,"endColumn":30},{"ruleId":"85","severity":1,"message":"86","line":17,"column":6,"nodeType":"87","endLine":17,"endColumn":21,"suggestions":"88"},{"ruleId":"77","severity":1,"message":"89","line":7,"column":10,"nodeType":"79","messageId":"80","endLine":7,"endColumn":23},{"ruleId":"77","severity":1,"message":"90","line":8,"column":10,"nodeType":"79","messageId":"80","endLine":8,"endColumn":22},{"ruleId":"77","severity":1,"message":"91","line":55,"column":11,"nodeT