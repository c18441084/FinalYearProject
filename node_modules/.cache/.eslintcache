nd(){\n        window.location = \"/found\";\n    }\n\n    return(\n        <div>\n            <title>FindMyOwner</title>\n            <div id = \"Title\">\n                <h1>FindMyOwner</h1>\n                <button id = \"logout\" onClick = {logout} >Log out</button>\n            </div>\n            <div id = \"sidebar\">\n                <button id = \"found\" onClick={found}>\n                    <h2>Found Pets</h2>\n                </button>\n                <a href = \"#\">\n                    <h2>Lost Pets</h2>\n                </a>\n                <a href = \"#\">\n                    <h2>Pet Clinics</h2>\n                </a>\n                <a href = \"#\">\n                    <h2 id = \"DWS\">Dog Warden Service</h2>\n                </a>\n            </div>\n            <div id = \"topbar\">\n                <h3 id = \"RP\">Recent Posts</h3>\n                <h3 id = \"PNM\">Posts near me</h3>\n            </div>\n            <div id = \"RecentPosts\">\n                \n            </div>\n            <div id = \"PostsNearMe\">\n\n            </div>\n        </div>\n    )\n}","/Users/niallmcnamara/Desktop/fyprep/FinalYearProject/src/Components/Found/Found.js",["56","57"],"/Users/niallmcnamara/Desktop/fyprep/FinalYearProject/src/Components/Login/Login.js",["58","59"],"import React, { useEffect, useState } from \"react\";\nimport { Link, useNavigate } from \"react-router-dom\";\nimport { auth, signInWithEmailAndPassword, signInWithFacebook } from \"../../firebaseconfig\";\nimport { useAuthState } from \"react-firebase-hooks/auth\";\nimport \"./Login.css\";\nfunction Login() {\n  const [email, setEmail] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [user, loading, error] = useAuthState(auth);\n  const history = useNavigate();\n  useEffect(() => {\n    if (loading) {\n      // maybe trigger a loading screen\n      return;\n    }\n    if (user) history(\"/home\");\n  }, [user, loading]);\n  return (\n    <div className=\"login\">\n      <div className=\"login__container\">\n        <input\n          type=\"text\"\n          className=\"login__textBox\"\n          value={email}\n          onChange={(e) => setEmail(e.target.value)}\n          placeholder=\"E-mail Address\"\n        />\n        <input\n          type=\"password\"\n          className=\"login__textBox\"\n          value={password}\n          onChange={(e) => setPassword(e.target.value)}\n          placeholder=\"Password\"\n        />\n        <button\n          className=\"login__btn\"\n          onClick={() => signInWithEmailAndPassword(email, password)}\n        >\n          Login\n        </button>\n        <button className=\"login__btn login__google\" onClick={signInWithFacebook}>\n          Login with Facebook\n        </button>\n        {/*<div>\n          <Link to=\"/reset\">Forgot Password</Link>\n        </div>*/}\n        <div>\n          Don't have an account? <Link to=\"/register\">Register</Link> now.\n        </div>\n      </div>\n    </div>\n  );\n}\nexport default Login;","/Users/niallmcnamara/Desktop/fyprep/FinalYearProject/src/firebaseconfig.js",["60","61","62","63","64","65"],"/Users/niallmcnamara/Desktop/fyprep/FinalYearProject/src/Components/Register/Register.js",[],"/Users/niallmcnamara/Desktop/fyprep/FinalYearProject/src/Components/FoundPetDetails/FoundPetDetails.js",["66","67","68","69","70","71","72","73","74"],"/Users/niallmcnamara/Desktop/fyprep/FinalYearProject/src/Components/FoundPetDetails/GoogleMaps.js",[],"/Users/niallmcnamara/Desktop/fyprep/FinalYearProject/src/keys.js",["75"],"const googleAPIkey = 'AIzaSyCwGo-9ejeEDZdnqjukoIYbBkknoPq-QFQ';\nconst dogBreedAPI = 'b8fef6dd-50c8-413d-9dd1-3049eb6d8fc1';\n\nexport {googleAPIkey};",{"ruleId":"76","replacedBy":"77"},{"ruleId":"78","replacedBy":"79"},{"ruleId":"80","severity":1,"message":"81","line":1,"column":8,"nodeType":"82","messageId":"83","endLine":1,"endColumn":12},{"ruleId":"84","severity":1,"message":"85","line":22,"column":17,"nodeTy